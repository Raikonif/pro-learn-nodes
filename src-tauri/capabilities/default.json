{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "learn-nodes-backend",
          "sidecar": true,
          "args": [
            "--uds",
            {
              "validator": ".+"
            }
          ]
        }
      ]
    }
  ]
}
