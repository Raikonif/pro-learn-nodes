# pnpm config — see https://pnpm.io/npmrc

# Security: do not run install lifecycle scripts from arbitrary dependencies.
# The `pnpm.onlyBuiltDependencies` field in package.json allowlists only the
# packages whose postinstall is functionally required (e.g. esbuild downloads
# a platform-specific native binary; rejecting it breaks Vite's dev server
# and production build). Everything else stays off until reviewed.
ignore-scripts=true

# Resolve peer dependencies automatically so apps don't break on minor
# version drift; we still pin everything in the lockfile.
auto-install-peers=true

# Surface every peer conflict instead of silently picking a winner.
strict-peer-dependencies=false